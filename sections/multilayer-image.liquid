{% liquid
  assign block_count = section.blocks.size
  assign highest_height = '720px'

  for block in section.blocks
    if block.settings.image != blank
      assign highest_height = block.settings.image.height | append: 'px'
      break
    endif
  endfor

  if section.settings.item_height == 'custom'
    assign highest_height = section.settings.item_height_custom | append: 'px'
  endif
%}

<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
    multilayer-image-block
    section-block-{{ section.id }}
  "
  style="
    {% if section.settings.section_width == 'custom' %}
      --page-content-width: {{ section.settings.page_width_custom | divided_by: 10 }}rem;
      --page-width: calc(var(--page-content-width) + var(--page-margin) * 2);
    {% endif %}
    --item-count: {{ block_count | at_least: 1 }};
    --item-height: {{ highest_height }};
    --item_border_radius: {{ section.settings.item_border_radius | append: 'px' }};
    --items_spacing: {{ section.settings.items_spacing | append: 'px' }};
    {% render 'spacing-style', settings: section.settings, type: 'section' %}
  "
>
  <div class="section-global__header">
    {%- content_for 'block', type: '_section-header', id: 'section-header' -%}
  </div>

  <multilayer-image class="multilayer-image">
    <div class="image-carousel">
      {% content_for 'blocks' %}
    </div>
  </multilayer-image>
</div>

