{%- comment -%}
  Pro Cavalli: grid of brand logo tiles built from a menu item's children (e.g. main menu > Brands).
  Each tile links to the brand collection and shows the collection's custom.brand_logo metafield,
  or the brand name when the collection has no logo. Brands without products can be skipped.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign parent_title = s.menu_item | strip
  assign brand_links = nil
  for top_link in linklists[s.menu].links
    if parent_title != blank and top_link.title == parent_title
      assign brand_links = top_link.links
      break
    elsif parent_title == blank and collection and top_link.url == collection.url
      assign brand_links = top_link.links
      break
    endif
  endfor
-%}

<style>
  #pc-brands-{{ section.id }} {
    padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;
  }
  @media (max-width: 749px) {
    #pc-brands-{{ section.id }} { padding-block: min({{ s.padding_top }}px, 32px) min({{ s.padding_bottom }}px, 32px); }
  }
</style>

<div id="pc-brands-{{ section.id }}" class="pc-brand-grid color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- if s.heading != blank -%}
      <h2 class="pc-brand-grid__heading">{{ s.heading | escape }}</h2>
    {%- endif -%}

    {%- if brand_links.size > 0 -%}
      <ul class="pc-brand-grid__list list-unstyled" role="list" style="--pc-brand-cols-desktop: {{ s.columns }};">
        {%- for link in brand_links -%}
          {%- liquid
            assign brand = link.object
            if s.hide_empty and link.type == 'collection_link' and brand.products_count == 0
              continue
            endif
            assign logo = nil
            if link.type == 'collection_link'
              assign logo = brand.metafields.custom.brand_logo.value
            endif
          -%}
          <li class="pc-brand-grid__item">
            <a href="{{ link.url }}" class="pc-brand-grid__link">
              <span class="pc-brand-grid__tile">
                {%- if logo != blank -%}
                  {{ logo | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 360, 480', sizes: '(min-width: 1025px) 15vw, 40vw', alt: link.title }}
                {%- else -%}
                  <span class="pc-brand-grid__name">{{ link.title | escape }}</span>
                {%- endif -%}
              </span>
              {%- if s.show_names -%}
                <span class="pc-brand-grid__title">{{ link.title | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="pc-brand-grid__empty">Pick the menu and the menu item whose sub-items are the brand collections.</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .pc-brand-grid__heading {
    margin: 0 0 clamp(24px, 2.5vw, 48px);
    font-family: var(--font-heading--family, Georgia, serif);
    font-weight: 400;
    font-size: clamp(28px, 2.083vw, 40px);
    line-height: 1.2;
    text-align: center;
    color: var(--pc-navy, #19264D);
  }
  /* flex, not grid, so a short last row is centred under the full rows */
  .pc-brand-grid__list {
    --pc-brand-gap: clamp(16px, 1.667vw, 32px);
    --pc-brand-cols: var(--pc-brand-cols-desktop, 6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--pc-brand-gap);
    margin: 0;
    padding: 0;
  }
  .pc-brand-grid__item {
    flex: 0 0 calc((100% - (var(--pc-brand-cols) - 1) * var(--pc-brand-gap)) / var(--pc-brand-cols));
    min-width: 0;
  }
  .pc-brand-grid__link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }
  .pc-brand-grid__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    min-height: 0; /* keep the ratio for tall logos (aspect-ratio otherwise grows to fit the image) */
    padding: 10% 14%;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .pc-brand-grid__tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .pc-brand-grid__link:hover .pc-brand-grid__tile,
  .pc-brand-grid__link:focus-visible .pc-brand-grid__tile {
    border-color: var(--pc-gold, #C2A260);
    box-shadow: 0 6px 20px rgba(25, 38, 77, 0.08);
  }
  .pc-brand-grid__name {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(16px, 1.042vw, 20px);
    line-height: 1.25;
    text-align: center;
    color: var(--pc-navy, #19264D);
  }
  .pc-brand-grid__title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-align: center;
    text-transform: uppercase;
  }
  .pc-brand-grid__link:hover .pc-brand-grid__title {
    color: var(--pc-gold, #C2A260);
  }
  @media (max-width: 1024px) {
    .pc-brand-grid__list { --pc-brand-cols: 4; }
  }
  @media (max-width: 749px) {
    .pc-brand-grid__list { --pc-brand-cols: 2; --pc-brand-gap: 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pro Cavalli brand logos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "menu_item",
      "label": "Menu item",
      "info": "Title of the menu item whose sub-items are the brand collections (e.g. Brands). Leave empty to use the menu item that links to this collection.",
      "default": "Brands"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Logos per row (desktop)",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_names",
      "label": "Show brand name under each logo",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "Hide brands with no products",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Pro Cavalli brand logos"
    }
  ]
}
{% endschema %}
