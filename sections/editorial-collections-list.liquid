      "options": [
        { "value": "pretty", "label": "t:options.pretty" },
        { "value": "balance", "label": "t:options.balance" },
        { "value": "nowrap", "label": "t:options.none" }
      ],
      "default": "pretty",
      "visible_if": "{{ section.settings.link_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "link_color",
      "label": "t:settings.color",
      "options": [
        { "value": "var(--color-foreground)", "label": "t:options.text" },
        { "value": "var(--color-foreground-heading)", "label": "t:options.heading" },
        { "value": "var(--color-primary)", "label": "t:options.link" }
      ],
      "default": "var(--color-foreground)",
      "visible_if": "{{ section.settings.link_type_preset != 'rte' }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "page_width_custom",
      "min": 1000,
      "max": 2000,
      "step": 10,
      "default": 1570,
      "unit": "px",
      "label": "t:settings.page_width",
      "visible_if": "{{ section.settings.section_width == 'custom' }}"
    },
    {
