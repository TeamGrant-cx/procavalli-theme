{%- if show_country or show_language -%}
  {%- liquid
    assign localization_layout = localization_layout | default: 'dropdown'
    assign localization_type = localization_type | default: 'icon'
    assign localization_icon_style = localization_icon_style | default: 'global'
    assign panel_country_style = panel_country_style | default: true

    assign localization_font = '--menu-localization-font: var(--font-[localization_font]--family); ' | replace: '[localization_font]', section.settings.localization_font
    assign localization_font_size = '--menu-localization-font-size: [localization_font_size]; ' | replace: '[localization_font_size]', section.settings.localization_font_size
    assign color_shadow = '--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));'
    assign form_style = localization_font | append: localization_font_size | append: color_shadow
  -%}

  {%- if panel_country_style == true or country_style == true -%}
    <link rel="stylesheet" href="{{ 'icon-flag.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endif -%}

  {%- assign hide_mobile = 'small-hide medium-hide' -%}

  {% if localization_layout == 'sidebar' %}
    <side-drawer-opener
      class="no-js-hidden header__column-action header__column-action--sidebar header-actions {{ hide_mobile }}"
      data-side-drawer="#Custom-Drawer"
    >
      <button
        class="header__icon header__icon--icon button relative gap-xs focus-inset utility-icon--drawer{% if class_icon_type != blank %} {{ class_icon_type }}{% endif %}{%  if actions_type != 'text' %} header__icon--utility{% endif %}{% if localization_type != 'icon' %} header__text--localization{% endif %}"
        type="button"
        aria-haspopup="dialog"
        aria-label="Header utility sidebar"
        id="utility-icon-bubble"
        style="{{ form_style }}"
      >
        {%- if localization_type != 'text' -%}
          {%- render 'localization-trigger-icon',
            localization_icon_style: localization_icon_style,
            country_style: country_style,
            flag_style: flag_style,
            show_country: show_country,
            show_language: show_language,
            is_sidebar: true
          -%}
        {%- endif -%}
        {%- if localization_type != 'icon' -%}
            <span class="uppercase">{% if show_language == true %}{{ localization.language.iso_code }}{% endif %}{% if show_language == true and show_country == true %}/{% endif %}{% if show_country == true %}{{ localization.country.currency.iso_code }}{% endif %}</span>
        {%- endif -%}
      </button>
    </side-drawer-opener>
  {% elsif localization_type == 'icon' %}
    <div class="header__column-action header__column-action--{{ localization_type }} header__icon--localization {{ hide_mobile }}">
      <div class="header-localization country-language-localization">
        {%- liquid
          assign show_language_selector = false
          if show_language and localization.available_languages.size > 1
            assign show_language_selector = true
          endif

          assign show_country_selector = false
          if show_country and localization.available_countries.size > 1
            assign show_country_selector = true
          endif
        -%}

        {%- if show_language_selector or show_country_selector -%}
          <div>
            <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'content.language_label' | t }}</h2>
            {%- render 'language-country-localization',
              localPosition: 'HeaderLanguage',
              country_style: country_style,
              panel_country_style: panel_country_style,
              flag_style: flag_style,
              show_language: show_language,
              show_country: show_country,
              localization_icon_style: localization_icon_style,
              section_id: section_id,
              localization_type: localization_type
            -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {% else %}
    <div class="header__column-action header__column-action--{{ localization_type }} header-localization header__text--localization{% if show_localization_shortcode == true %} short-layout{% endif %} desktop-localization-wrapper max-md:hidden gap-xs">
      {%- if show_language and localization.available_languages.size > 1 -%}
        <localization-form class="{{ hide_mobile }}" data-prevent-hide activate-event="hover">
          {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'content.language_label' | t }}</h2>
              {%- render 'language-localization',
                localPosition: 'HeaderLanguage',
                country_style: country_style,
                panel_country_style: panel_country_style,
                flag_style: flag_style,
                show_localization_shortcode: show_localization_shortcode,
                localization_icon_style: localization_icon_style,
                show_country: show_country,
                show_language: show_language,
                localization_type: localization_type
              -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}

      {%- if show_language and show_country -%}
        {% if show_localization_shortcode == true %}
          <span class="separator {{ hide_mobile }}">/</span>
        {% else %}
          <span class="separator {{ hide_mobile }}">|</span>
        {% endif %}
      {%- endif -%}

      {%- if show_country and localization.available_countries.size > 1 -%}
        <localization-form class="{{ hide_mobile }}" data-prevent-hide activate-event="hover">
          {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'content.country_label' | t }}</h2>
              {%- render 'country-localization',
                localPosition: 'HeaderCountry',
                country_style: country_style,
                panel_country_style: panel_country_style,
                flag_style: flag_style,
                show_localization_shortcode: show_localization_shortcode,
                localization_icon_style: localization_icon_style,
                show_country: show_country,
                show_language: show_language,
                localization_type: localization_type
              -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}
    </div>
  {% endif %}
{%- endif -%}
