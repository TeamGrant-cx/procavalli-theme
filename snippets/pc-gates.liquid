{%- comment -%}
  Pro Cavalli custom-work license check — load-bearing variant.

  TWO MODES:

  1. Default render (no parameters) — called once from <head> in
     layout/theme.liquid: {% render 'pc-gates' %}
     Outputs the client-side gate (styles + script) that reveals or hides
     elements carrying data-pc-gate based on the endpoint's `active` flag.

  2. Section check — called with section_check: true from any gated
     section wrapper: {% render 'pc-gates', section_check: true %}
     Returns the sentinel string `pc-ok` so the calling section knows
     this snippet exists and is intact. If the snippet is deleted or
     tampered with, the sentinel is missing and the section's wrapper
     refuses to render its contents (server-side kill).

  LOAD-BEARING BEHAVIOR:

  - Server-side (Layer 1): Gated sections wrap their content in a
    `capture` + `contains 'pc-ok'` check. Remove or rename this file,
    or strip the sentinel branch, and every gated section renders empty.
    No HTML reaches the browser at all.

  - Client-side (Layer 2): Gated elements are hidden by default. Only
    this script's `pc-verified` class on <html> reveals them. Remove the
    snippet, and nothing marked data-pc-gate ever becomes visible, even
    if the Liquid wrapper is bypassed.

  FAIL-OPEN FOR THE ACTIVE/INACTIVE DECISION:

  Once the snippet is present and ran, a network error, bad response or
  outage leaves gated elements VISIBLE (fail-open). Only an explicit
  boolean `active: false` from the endpoint hides them.

  The snippet's own presence is NOT fail-open. If the snippet is gone,
  gated elements stay hidden — that is the whole point of the gate.
{%- endcomment -%}

{%- if section_check -%}pc-ok{%- else -%}
<style>
  /* Default: anything marked data-pc-gate is INVISIBLE until this script
     adds `pc-verified` to <html>. If the snippet is removed, these
     elements never become visible. */
  [data-pc-gate]      { display: none !important; }
  [data-pc-gate-stub] { display: none; }

  /* Snippet present and ran: reveal gated elements. */
  html.pc-verified [data-pc-gate] { display: revert !important; }

  /* Snippet present and license is OFF: hide gated elements, show stubs. */
  html.pc-verified.pc-off [data-pc-gate]      { display: none  !important; }
  html.pc-verified.pc-off [data-pc-gate-stub] { display: block !important; }
</style>

<script>
(function () {
  var ENDPOINT  = 'https://procavalli-license.vercel.app/status';
  var CACHE_KEY = 'pc_lic_v1';
  var MAX_AGE   = 10 * 60 * 1000;

  var html = document.documentElement;

  function apply(active) {
    html.classList.add('pc-verified');          // prove the snippet ran
    if (active) html.classList.remove('pc-off');
    else        html.classList.add('pc-off');
  }

  // Apply a recent cached value to reduce flicker on subsequent page loads.
  var hadCache = false;
  try {
    var raw = sessionStorage.getItem(CACHE_KEY);
    if (raw) {
      var c = JSON.parse(raw);
      if (c && typeof c.active === 'boolean' && (Date.now() - c.t) < MAX_AGE) {
        apply(c.active);
        hadCache = true;
      }
    }
  } catch (e) { /* storage unavailable — ignore */ }

  // No cached value yet? Fail-open on first paint by assuming active, so
  // gated sections don't flash-hide before the fetch returns. The snippet
  // still had to run for this to happen — missing snippet = still hidden.
  if (!hadCache) {
    html.classList.add('pc-verified');
  }

  // Refresh the status in the background. Failures leave the current page
  // state unchanged (fail-open for the active/inactive decision).
  var ctl = ('AbortController' in window) ? new AbortController() : null;
  if (ctl) setTimeout(function () {
    try { ctl.abort(); } catch (e) {}
  }, 4000);

  try {
    fetch(ENDPOINT, {
      cache: 'no-store',
      credentials: 'omit',
      signal: ctl ? ctl.signal : undefined
    })
      .then(function (response) { return response.ok ? response.json() : null; })
      .then(function (data) {
        if (!data || typeof data.active !== 'boolean') return;
        try {
          sessionStorage.setItem(CACHE_KEY, JSON.stringify({
            active: data.active,
            t: Date.now()
          }));
        } catch (e) { /* storage unavailable — ignore */ }
        apply(data.active);
      })
      .catch(function () { /* fail open */ });
  } catch (e) { /* fail open */ }
})();
</script>
{%- endif -%}
