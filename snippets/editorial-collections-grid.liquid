{%- liquid
  assign layout_style = layout_style | default: 'style_1'
  assign animation_type = animation_type | default: 'none'
  assign item_settings = settings

  assign image_class = 'image-block editorial-collections__image'
  if animation_type == 'offset-border'
    assign image_class = image_class | append: ' editorial-collections__image--offset-border'
  else
    assign image_class = image_class | append: ' image-zoomin'
  endif
  assign link_label = link_text | default: 'Shop the collection'

  assign title_type_preset = item_settings.title_type_preset | default: 'h4'
  assign title_font_weight = item_settings.title_font_weight
  if title_font_weight == 'default'
    assign title_font_weight = blank
  endif

  assign link_type_preset = item_settings.link_type_preset | default: 'rte'
  assign link_font_weight = item_settings.link_font_weight
  if link_font_weight == 'default'
    assign link_font_weight = blank
  endif

  assign title_preset_class = title_type_preset
  if title_preset_class == 'rte'
    assign title_preset_class = blank
  endif

  assign link_preset_class = link_type_preset
  if link_preset_class == 'rte'
    assign link_preset_class = blank
  endif
-%}

{%- capture title_block_classes -%}
  {%- if title_type_preset == 'custom' -%}
    custom-typography
    {%- if item_settings.title_font_size != blank %} custom-font-size{% endif -%}
  {%- endif -%}
  {%- if title_type_preset != 'rte' and item_settings.title_color != blank %} custom-color{% endif -%}
  {%- if title_type_preset == 'rte' or title_type_preset == 'paragraph' %} rte{% endif -%}
{%- endcapture -%}

{%- capture link_block_classes -%}
  {%- if link_type_preset == 'custom' -%}
    custom-typography
    {%- if item_settings.link_font_size != blank %} custom-font-size{% endif -%}
  {%- endif -%}
  {%- if link_type_preset != 'rte' and item_settings.link_color != blank %} custom-color{% endif -%}
{%- endcapture -%}

{%- capture title_typography_style -%}
  {% render 'typography-style',
    preset: title_type_preset,
    font: item_settings.title_font,
    font_size: item_settings.title_font_size,
    weight: title_font_weight,
    case: item_settings.title_case,
    wrap: item_settings.title_wrap,
    line_height: item_settings.title_line_height,
    letter_spacing: item_settings.title_letter_spacing,
    color: item_settings.title_color
  %}
{%- endcapture -%}

{%- capture link_typography_style -%}
  {% render 'typography-style',
    preset: link_type_preset,
    font: item_settings.link_font,
    font_size: item_settings.link_font_size,
    weight: link_font_weight,
    case: item_settings.link_case,
    wrap: item_settings.link_wrap,
    line_height: item_settings.link_line_height,
    letter_spacing: item_settings.link_letter_spacing,
    color: item_settings.link_color,
    button_link: true
  %}
  {%- if link_type_preset == 'custom' -%}
    --button-font-size-link: var(--font-size);
    --button-font-weight-link: var(--font-weight);
    --button-type-font-link: var(--font-family);
  {%- elsif link_type_preset == 'paragraph' -%}
    --button-font-size-link: var(--font-size--paragraph);
  {%- elsif link_type_preset != 'rte' -%}
    --button-font-size-link: var(--font-size--{{ link_type_preset }});
  {%- else -%}
    --button-font-size-link: clamp(1.3rem, 1.6vw, 1.6rem);
    --button-font-weight-link: 700;
  {%- endif -%}
{%- endcapture -%}

<ul class="grid grid-layout list-unstyled editorial-list{% if layout_style == 'style_2' %} editorial-list--style_2{% endif %} lg:grid-layout--2 md:grid-layout--2 max-sm:grid-layout--1">
  {% for collection in collections %}
    {% liquid
      assign current_grid_index = forloop.index0 | divided_by: 10
      assign pt = 0
      assign pb = 0
      assign pl = 0
      assign pr = 0
      assign pt_mb = 0
      assign pb_mb = 0
      assign pl_mb = 0
      assign pr_mb = 0
      assign mt = 0
      assign mb = 0
      assign ml = 0
      assign mr = 0
      assign mt_mb = 0
      assign mb_mb = 0
      assign ml_mb = 0
      assign mr_mb = 0

      if layout_style == 'style_2'
        assign current_item_index = forloop.index0 | modulo: 6

        case current_item_index
          when 0
            # Left top — large square, sits lower than right top
            assign pt = 15
            assign pb = 6
            assign pl = 14
            assign pr = 0
            assign pt_mb = 4
            assign pb_mb = 0
            assign pl_mb = 5
            assign pr_mb = 10
          when 1
            # Right top — smaller, higher, indented from left
            assign pt = 0
            assign pb = 4
            assign pl = 0
            assign pr = 10
            assign pt_mb = 6
            assign pb_mb = 0
            assign pl_mb = 16
            assign pr_mb = 5
          when 2
            # Left bottom — indented toward center
            assign pt = 0
            assign pb = 4
            assign pl = 26
            assign pr = 0
            assign pt_mb = 8
            assign pb_mb = 0
            assign pl_mb = 5
            assign pr_mb = 5
          when 3
            # Right bottom — tall, pulled up to stagger with left column
            assign pt = 0
            assign pb = 6
            assign pl = 0
            assign pr = 0
            assign mt = -37
            assign pt_mb = 6
            assign pb_mb = 0
            assign pl_mb = 16
            assign pr_mb = 5
          when 4
            # Left — next row, similar to item 0 with more top space
            assign pt = 14
            assign pb = 6
            assign pl = 6
            assign pr = 24
            assign pt_mb = 6
            assign pb_mb = 0
            assign pl_mb = 5
            assign pr_mb = 10
          when 5
            # Right — next row, pulled up like item 3
            assign pt = 8
            assign pb = 6
            assign pl = 14
            assign pr = 12
            assign mt = -38
            assign pt_mb = 6
            assign pb_mb = 0
            assign pl_mb = 16
            assign pr_mb = 5
        endcase
      else
        assign current_item_index = forloop.index0 | modulo: 10

        case current_item_index
          when 0
            assign pt = 10
            assign pb = 0
            assign pl = 7
            assign pr = 10.5
            assign pt_mb = 3.8
            assign pb_mb = 0
            assign pl_mb = 5
            assign pr_mb = 10.8
          when 1
            assign pl = 28.5
            assign pr = 20
            assign pt_mb = 7.5
            assign pb_mb = 0
            assign pl_mb = 18.7
            assign pr_mb = 5
          when 2
            assign pt = 5
            assign pl = 39
            assign pt_mb = 7.7
            assign pb_mb = 0
            assign pl_mb = 5
            assign pr_mb = 16.8
          when 3
            assign pb = 10
            assign pl = 15
            assign pr = 7
            assign mt = -38
            assign pt_mb = 7.5
            assign pb_mb = 0
            assign pl_mb = 12.4
            assign pr_mb = 5
          when 4
            assign pt = 15
            assign pl = 7
            assign pr = 28.5
            assign pt_mb = 7.5
            assign pb_mb = 0
            assign pl_mb = 5
            assign pr_mb = 10.8
          when 5
            assign pt = 12
            assign pb = 10
            assign pl = 15.5
            assign pr = 17.5
            assign mt = -36.5
            assign pt_mb = 7.5
            assign pl_mb = 18.7
        endcase
      endif
    %}

    <li class="grid__item editorial-item scroll-trigger animate--slide-in" style="--animation-order: {{ current_grid_index }}">
      <div
        class="h-full editorial-collections__item"
        style="
          --editorial-margin-top: {{ mt }}%;
          --editorial-margin-bottom: {{ mb }}%;
          --editorial-margin-left: {{ ml }}%;
          --editorial-margin-right: {{ mr }}%;

          --editorial-margin-top-mb: {{ mt_mb }}%;
          --editorial-margin-bottom-mb: {{ mb_mb }}%;
          --editorial-margin-left-mb: {{ ml_mb }}%;
          --editorial-margin-right-mb: {{ mr_mb }}%;

          --editorial-padding-top: {{ pt }}%;
          --editorial-padding-bottom: {{ pb }}%;
          --editorial-padding-left: {{ pl }}%;
          --editorial-padding-right: {{ pr }}%;

          --editorial-padding-top-mb: {{ pt_mb }}%;
          --editorial-padding-bottom-mb: {{ pb_mb }}%;
          --editorial-padding-left-mb: {{ pl_mb }}%;
          --editorial-padding-right-mb: {{ pr_mb }}%;
        "
      >
        <a href="{{ collection.url }}" class="{{ image_class }}">
          {% render 'image',
            image: collection.image,
            class: 'image-block__image',
            loading: 'lazy',
            fetch_priority: 'high',
            sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
            widths: '100vw, 50vw, 33vw'
          %}
        </a>
        <div
          class="
            size-style
            spacing-style
            text-block
            max-w-full
            flex
            flex-column
            editorial-collections__title
            {{ title_preset_class }}
            {{ title_block_classes }}
          "
          style="
            --size-style-width: fit-content;
            --size-style-width-tablet: fit-content;
            --size-style-width-mobile: fit-content;
            --size-style-width-mobile-min: fit-content;
            --padding-block-start: calc(25px + var(--editorial-border-offset, 0px));
            --padding-block-end: 8px;
            --padding-inline-start: 0px;
            --padding-inline-end: 0px;
            {{ title_typography_style }}
          "
        >
          <p>{{ collection.title }}</p>
        </div>
        <a
          href="{{ collection.url }}"
          class="
            size-style
            link
            link--underline
            editorial-collections__link
            {{ link_preset_class }}
            {{ link_block_classes }}
          "
          style="
            --size-style-width: fit-content;
            --size-style-width-tablet: fit-content;
            --size-style-width-mobile: fit-content;
            --size-style-width-mobile-min: fit-content;
            {{ link_typography_style }}
          "
        >
          <span class="text">{{ link_label }}</span>
        </a>
      </div>
    </li>
  {% endfor %}
</ul>
