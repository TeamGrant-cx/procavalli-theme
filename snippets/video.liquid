{% doc %}
  Renders a video element, from a video object (<video> element) or a video URL (<iframe> element)

  Shared parameters:

  @param {boolean} [video_autoplay] - Whether the video should autoplay
  @param {boolean} [video_loop] - Whether the video should loop
  @param {string} [video_class] - Additional classes for the video element
  @param {string} [video_id] - The video ID
  @param {string} [video_style] - Additional inline styles
  @param {object} [video_preview_image] - Preview image to show before video plays
  @param {string} [video_ratio] - The aspect ratio of the video
  @param {string} [widths] - Responsive widths
  @param {string} [sizes] - Responsive sizes
  @param {string} [loading] - Loading attribute
  @param {string} [additional_attributes] - Any additional HTML attributes
  @param {string} [video_type] - 'youtube' or 'vimeo'
  @param {boolean} [disable_controls] - Whether to disable controls. If true, only play/pause will be usable.
  @param {object} video - The Shopify video object or a string containing a YouTube ID or Vimeo ID
  @param {object} [block] - The block object
  @param {string} [section] - The section object

  Video from URL:

  @param {boolean} [video_from_url] - Set to true to use a video from URL instead of a Shopify video object
  @param {string} [video_alt] - The video alt text

  @example
  {% render 'video', video: section.settings.video, video_autoplay: true, video_loop: true, section_id: section.id %}
{% enddoc %}

{% assign video_id = section.settings.video.id | default: section.settings.video_url.id | default: video_id %}
{% assign video_alt = video_alt | default: video.alt %}
{% assign alt = 'content.load_video' | t: description: video_alt | escape %}
{% assign video_preview_image = video_preview_image | default: video.preview_image %}
{% assign video_autoplay = video_autoplay | default: block.settings.video_autoplay %}
{% assign video_loop = video_loop | default: block.settings.video_loop %}
{% assign video_layout = video_layout | default: block.settings.video_layout | default: section.settings.video_layout | default: 'default' %}
{% liquid
  assign media_width_desktop = 100 | divided_by: 2 | append: 'vw'
  assign media_width_mobile = '100vw'
  assign sizes = '(min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
%}

{% if video_from_url %}
  {% liquid
    if video_type == 'youtube'
      assign video_src = 'https://www.youtube.com/embed/VIDEO_ID?' | replace: 'VIDEO_ID', video

      if video_autoplay == false and video_preview_image != blank
        assign video_src = video_src | append: '&autoplay=1'
      endif

      if video_autoplay
        assign video_src = video_src | append: '&autoplay=1&mute=1'
      endif

      if video_loop
        assign video_src = video_src | append: '&playlist=' | append: video | append: '&loop=1'
      endif
      if disable_controls
        assign video_src = video_src | append: '&controls=0'
        assign video_src = video_src | append: '&enablejsapi=1'
      endif
      assign class = 'js-youtube w-full'
    else
      assign video_src = 'https://player.vimeo.com/video/VIDEO_ID?' | replace: 'VIDEO_ID', video

      if video_autoplay == false and video_preview_image != blank
        assign video_src = video_src | append: '&autoplay=1'
      endif

      if video_autoplay
        assign video_src = video_src | append: '&autoplay=1&muted=1'
      endif
      if video_loop
        assign video_src = video_src | append: '&loop=1'
      endif
      if disable_controls
        assign video_src = video_src | append: '&controls=0'
        assign video_src = video_src | append: '&api=1'
      endif
      assign class = 'js-vimeo'
    endif
  %}
  {% capture video_iframe %}
      <iframe
        src="{{ video_src }}"
        class="{{ class }} media--{{ video_ratio }}"
        allow="autoplay; encrypted-media"
        allowfullscreen
        title="{{ video_alt | escape }}"
      ></iframe>
  {% endcapture %}
{% else %}
  {% liquid
    assign requested_js_api = enable_js_api
    if video_layout == 'custom'
      assign controls = false
      assign enable_js_api = true
    elsif disable_controls
      assign controls = false
      assign enable_js_api = true
    else
      assign controls = true
      if requested_js_api
        assign enable_js_api = true
      else
        assign enable_js_api = false
      endif
    endif
  %}

  {% capture video_tag %}
    {% if video.host == 'youtube' %}
      {{
        video
        | external_video_url: autoplay: true, loop: video_loop, playlist: video.external_id, mute: '1', controls: controls, enablejsapi: 1
        | external_video_tag: data-video-type: 'youtube', class: 'js-youtube'
      }}
    {% elsif video.host == 'vimeo' %}
      {% if video.external_id != blank %}
        {% liquid
          assign vimeo_src = 'https://player.vimeo.com/video/' | append: video.external_id | append: '?autoplay=1&muted=1&autopause=0&playsinline=1&api=1'
          if video_loop
            assign vimeo_src = vimeo_src | append: '&loop=1'
          endif
          unless controls
            assign vimeo_src = vimeo_src | append: '&controls=0'
          endunless
        %}
        <iframe
          src="{{ vimeo_src }}"
          class="js-vimeo"
          data-video-type="vimeo"
          allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
          allowfullscreen
          frameborder="0"
          title="{{ video_alt | escape }}"
        ></iframe>
      {% else %}
        {{
          video
          | external_video_url: autoplay: true, loop: video_loop, muted: true, controls: controls, api: 1
          | external_video_tag: data-video-type: 'vimeo', class: 'js-vimeo'
        }}
      {% endif %}
    {% else %}
      {{ video | video_tag: image_size: '2500x', autoplay: true, loop: video_loop, muted: true, controls: controls }}
    {% endif %}
  {% endcapture %}
{% endif %}

{% if video != blank %}
  <deferred-media
    class="deferred-media relative overflow-hidden {{ video_class }}"
    style="{{ video_style }}"
    data-media-id="{{ video_id }}"
    {% if video_autoplay %}
      autoplay
    {% endif %}
    {{ additional_attributes }}
  >
    {% if video_preview_image != blank %}
      <button
        id="Deferred-Poster-Modal-{{ video_id }}"
        class="button deferred-media__poster deferred-media__poster-button button-unstyled w-full media--{{ video_ratio }}"
        aria-label="{{ alt }}"
        type="button"
        style="--video-aspect-ratio: {{ video.aspect_ratio }}"
      >
        {{
          video_preview_image
          | image_url: width: 3840
          | image_tag: widths: widths, sizes: sizes, loading: loading, class: 'deferred-media__poster-image', alt: video_alt
        }}

        <span class="deferred-media__poster-icon icon-play">
          <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
          {{- 'icon-play.svg' | inline_asset_content -}}
        </span>
      </button>
    {% endif %}

    {% if disable_controls %}
      <button
        class="button button-unstyled deferred-media__poster-button video-interaction-hint hidden"
        data-click-handler="toggleMediaButton"
        type="button"
      >
        <span class="deferred-media__poster-icon icon-play hidden">
          <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
          {{- 'icon-play.svg' | inline_asset_content -}}
        </span>
        <span class="deferred-media__poster-icon icon-pause hidden">
          <span class="visually-hidden">{{ 'accessibility.pause_video' | t }}</span>
          {{- 'icon-pause.svg' | inline_asset_content -}}
        </span>
      </button>
    {% endif %}

    {% capture video_content %}
      {% if video_layout == 'custom' %}
        <div class="custom-video-wrapper">
          {{ video_tag }}
          <button type="button" class="video-btn-toggle" aria-label="Toggle Play/Pause">
            <svg class="icon-play-svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <svg class="icon-pause-svg" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
              <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
            </svg>
          </button>
          <div class="video-progress-container">
            <div class="video-progress-bar"></div>
          </div>
        </div>
      {% else %}
        {{ video_tag }}
      {% endif %}
    {% endcapture %}

    <template>
      {% if video_from_url %}
        {{ video_iframe }}
      {% else %}
        {{ video_content }}
      {% endif %}
    </template>

    {% unless defer_embed %}
      {% if video_autoplay or video_preview_image == blank %}
        {% if video_from_url %}
          {{ video_iframe }}
        {% else %}
          {{ video_content }}
        {% endif %}
      {% endif %}
    {% endunless %}
  </deferred-media>
{% else %}
  <div
    {{ additional_attributes }}
    class="{%- if video_class -%}{{ video_class }} {%- endif -%}video-placeholder-wrapper"
    style="{%- if video_style -%}{{ video_style }} {%- endif -%}--video-placeholder-width: {{ block.settings.custom_width | default: 100 }}%;"
  >
    {% if video_preview_image != blank and video_autoplay == false %}
      {{ video_preview_image | image_url: width: 3840 | image_tag: widths: widths, sizes: sizes, loading: loading }}
    {% else %}
      {%- assign placeholder_name = placeholder | default: 'hero-apparel-3' -%}
      {%- if placeholder_name == blank -%}
        {%- assign placeholder_name = 'hero-apparel-3' -%}
      {%- endif -%}
      {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
    <span class="video-placeholder-wrapper__poster-icon icon-play">
      <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
      {{- 'icon-play.svg' | inline_asset_content -}}
    </span>
  </div>
{% endif %}

{% if video_layout == 'custom' %}
<style>
  .custom-video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
  }

  .custom-video-wrapper video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .video-btn-toggle {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    background: transparent;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 10;
    padding: 0;
  }

  .video-btn-toggle:hover {
    background: rgba(0, 0, 0, 0.5);
    transform: scale(1.08);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .video-btn-toggle svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .video-progress-container {
    position: absolute;
    bottom: 24px;
    left: 32px;
    right: 32px;
    width: auto;
    height: 8px;
    background: rgba(255, 255, 255, 0.30);
    cursor: pointer;
    z-index: 10;
    transition: height 0.2s ease;
  }

  .video-progress-container:hover {
    height: 10px;
  }

  .video-progress-bar {
    height: 100%;
    width: 0%;
    background: #ffffff;
    border-radius: 2px;
    transition: width 0.1s linear;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.4);
  }
</style>

<script>
  if (!window.customVideoControlsInitialized) {
    window.customVideoControlsInitialized = true;

    // Play event listener (Capturing phase to handle dynamic/lazy-loaded videos)
    document.addEventListener('play', function(e) {
      const video = e.target;
      if (!video || video.tagName !== 'VIDEO') return;
      const wrapper = video.closest('.custom-video-wrapper');
      if (!wrapper) return;
      const toggleBtn = wrapper.querySelector('.video-btn-toggle');
      if (!toggleBtn) return;
      
      const playIcon = toggleBtn.querySelector('.icon-play-svg');
      const pauseIcon = toggleBtn.querySelector('.icon-pause-svg');
      if (playIcon) playIcon.style.display = 'none';
      if (pauseIcon) pauseIcon.style.display = 'block';
    }, true);

    // Pause event listener (Capturing phase)
    document.addEventListener('pause', function(e) {
      const video = e.target;
      if (!video || video.tagName !== 'VIDEO') return;
      const wrapper = video.closest('.custom-video-wrapper');
      if (!wrapper) return;
      const toggleBtn = wrapper.querySelector('.video-btn-toggle');
      if (!toggleBtn) return;
      
      const playIcon = toggleBtn.querySelector('.icon-play-svg');
      const pauseIcon = toggleBtn.querySelector('.icon-pause-svg');
      if (playIcon) playIcon.style.display = 'block';
      if (pauseIcon) pauseIcon.style.display = 'none';
    }, true);

    // Timeupdate event listener (Capturing phase) for progress bar
    document.addEventListener('timeupdate', function(e) {
      const video = e.target;
      if (!video || video.tagName !== 'VIDEO') return;
      const wrapper = video.closest('.custom-video-wrapper');
      if (!wrapper) return;
      const progressBar = wrapper.querySelector('.video-progress-bar');
      if (!progressBar) return;
      
      if (video.duration) {
        const percentage = (video.currentTime / video.duration) * 100;
        progressBar.style.width = percentage + '%';
      }
    }, true);

    // Click on progress container to seek/scrub
    document.addEventListener('click', function(e) {
      const progressContainer = e.target.closest('.video-progress-container');
      if (!progressContainer) return;
      const wrapper = progressContainer.closest('.custom-video-wrapper');
      if (!wrapper) return;
      const video = wrapper.querySelector('video');
      if (!video || !video.duration) return;

      const rect = progressContainer.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const width = rect.width;
      const clickPercentage = Math.max(0, Math.min(1, clickX / width));
      video.currentTime = clickPercentage * video.duration;
    });

    // Click on play/pause toggle button
    document.addEventListener('click', function(e) {
      const toggleBtn = e.target.closest('.video-btn-toggle');
      if (!toggleBtn) return;
      const wrapper = toggleBtn.closest('.custom-video-wrapper');
      if (!wrapper) return;
      const video = wrapper.querySelector('video');
      if (!video) return;

      if (video.paused) {
        video.play().catch(function(err) {
          console.error("Play failed:", err);
        });
      } else {
        video.pause();
      }
    });

    // Click on video itself to play/pause
    document.addEventListener('click', function(e) {
      const video = e.target;
      if (!video || video.tagName !== 'VIDEO') return;
      const wrapper = video.closest('.custom-video-wrapper');
      if (!wrapper) return;
      // Prevent double trigger if clicking near elements inside wrapper
      if (e.target.closest('.video-btn-toggle') || e.target.closest('.video-progress-container')) return;
      
      if (video.paused) {
        video.play().catch(function(err) {
          console.error("Play failed:", err);
        });
      } else {
        video.pause();
      }
    });
  }
</script>
{% endif %}
