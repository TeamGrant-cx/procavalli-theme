{%- liquid
  assign account_menu = linklists['customer-account-main-menu']
-%}

<side-drawer
  id="Drawer-Account"
  class="drawer drawer__container account-drawer fixed top-0 left-0 w-screen h-full z-9 flex no-js-hidden"
  data-drawer-direction="right"
>
  <div id="Drawer-Overlay-Account" class="drawer__overlay fixed inset-0 cursor-pointer"></div>
  <div
    class="drawer__inner-wrapper color-{{ settings.popover_color_scheme }}"
    data-drawer-content
    style="--drawer-max-width: var(--normal-content-width);"
  >
    <div
      class="drawer__inner cus-scrollbar"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'content.account_title' | t }}"
      tabindex="-1"
    >
      <div
        class="drawer__header flex justify-between items-center relative"
        style="--gap-x: 1rem;--p: var(--padding-xs) 0;"
      >
        <h2 class="drawer__heading break m-0 h5">
          {%- if customer and customer.first_name != blank -%}
            {{ 'content.account_title_personalized' | t: first_name: customer.first_name }}
          {%- else -%}
            {{ 'content.account_title' | t }}
          {%- endif -%}
        </h2>
        <button
          class="drawer__close block t-button bor-none rounded-full cursor-pointer"
          type="button"
          onclick="this.closest('side-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      <div class="drawer__wrapper relative h-full cus-scrollbar motion-reduce" style="--p: 1.5rem 0 0;">
        <div class="drawer__content">
          <div class="drawer__content-inner account-drawer__content">
            {%- unless customer -%}
              <div class="account-drawer__signin-stack">
                {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
                  {%- capture shop_login_button -%}
                    {{ shop | login_button }}
                  {%- endcapture -%}
                  {{ shop_login_button | replace: '<shop-login-button', '<shop-login-button full-width persist-after-sign-in analytics-context="loginWithShopSelfServe"' }}
                {%- else -%}
                  <a
                    class="account-drawer__btn account-drawer__btn--shop"
                    href="{{ routes.account_login_url }}"
                  >
                    {{ 'actions.sign_in_with_shop' | t }}
                  </a>
                {%- endif -%}

                <a
                  class="account-drawer__btn account-drawer__btn--other button"
                  href="{{ routes.account_login_url }}"
                >
                  {{ 'actions.sign_in_options' | t }}
                </a>
              </div>
            {%- endunless -%}

            {%- if customer.email != blank -%}
              <p class="account-drawer__email m-0">{{ customer.email | escape }}</p>
            {%- endif -%}

            <div class="account-drawer__links">
              {%- if account_menu != blank and account_menu.links.size > 0 -%}
                {%- for link in account_menu.links -%}
                  {%- liquid
                    assign link_title_downcase = link.title | downcase
                    assign is_orders_link = false
                    if link_title_downcase contains 'order'
                      assign is_orders_link = true
                    endif
                  -%}
                  <a class="account-drawer__btn account-drawer__btn--outline button-secondary" href="{{ link.url }}">
                    <span class="account-drawer__btn-icon" aria-hidden="true">
                      {%- if is_orders_link -%}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" width="18" height="18" focusable="false">
                          <path d="M3.5 6.5 10 3.5 16.5 6.5v7L10 16.5 3.5 13.5v-7Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                          <path d="M3.5 6.5 10 9.5 16.5 6.5M10 9.5v7" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                        </svg>
                      {%- else -%}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" width="18" height="18" focusable="false">
                          <circle cx="10" cy="6.5" r="2.75" stroke="currentColor" stroke-width="1.2"/>
                          <path d="M4.5 16.25c.7-2.6 2.7-4 5.5-4s4.8 1.4 5.5 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                        </svg>
                      {%- endif -%}
                    </span>
                    <span class="text">{{ link.title | escape }}</span>
                  </a>
                {%- endfor -%}
              {%- else -%}
                <a class="account-drawer__btn account-drawer__btn--outline button-secondary" href="{{ routes.account_url }}">
                  <span class="account-drawer__btn-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" width="18" height="18" focusable="false">
                      <path d="M3.5 6.5 10 3.5 16.5 6.5v7L10 16.5 3.5 13.5v-7Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                      <path d="M3.5 6.5 10 9.5 16.5 6.5M10 9.5v7" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span class="text">{{ 'content.account_orders' | t }}</span>
                </a>
                <a class="account-drawer__btn account-drawer__btn--outline button-secondary" href="{{ routes.account_url }}">
                  <span class="account-drawer__btn-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" width="18" height="18" focusable="false">
                      <circle cx="10" cy="6.5" r="2.75" stroke="currentColor" stroke-width="1.2"/>
                      <path d="M4.5 16.25c.7-2.6 2.7-4 5.5-4s4.8 1.4 5.5 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                  </span>
                  <span class="text">{{ 'content.account_profile' | t }}</span>
                </a>
              {%- endif -%}
            </div>

            {%- if customer -%}
              <a class="account-drawer__logout link link--hover-underline paragraph" href="{{ routes.account_logout_url }}">
                {{ 'customer.log_out' | t }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</side-drawer>

{%- if customer == nil and shop.features.login_with_shop_classic_customer_accounts? -%}
<script>
  (() => {
    const accountPath = {{ routes.account_url | json }};
    let shopLoginPending = false;
    let reloading = false;

    const reloadAfterShopLogin = () => {
      if (reloading) return;
      reloading = true;
      window.location.reload();
    };

    const isLoggedInResponse = (response) => {
      if (!response) return false;
      const url = response.url || '';
      return (
        response.ok &&
        !url.includes('/login') &&
        !url.includes('customer_authentication')
      );
    };

    const reloadIfSignedIn = () => {
      fetch(accountPath, {
        credentials: 'same-origin',
        redirect: 'follow',
        headers: { Accept: 'text/html' },
      })
        .then((response) => {
          if (isLoggedInResponse(response)) reloadAfterShopLogin();
        })
        .catch(() => {});
    };

    const bindShopLoginButton = (button) => {
      if (!(button instanceof HTMLElement) || button.dataset.shopLoginBound) return;
      button.dataset.shopLoginBound = 'true';
      ['completed', 'login', 'signedin', 'success'].forEach((eventName) => {
        button.addEventListener(eventName, reloadAfterShopLogin);
      });
    };

    document.addEventListener('storefront:signincompleted', reloadAfterShopLogin);

    document.addEventListener(
      'click',
      (event) => {
        if (event.target.closest('shop-login-button')) shopLoginPending = true;
      },
      true
    );

    window.addEventListener('focus', () => {
      if (!shopLoginPending) return;
      shopLoginPending = false;
      setTimeout(reloadIfSignedIn, 400);
    });

    const bindAllShopLoginButtons = () => {
      document.querySelectorAll('shop-login-button').forEach(bindShopLoginButton);
    };

    bindAllShopLoginButtons();
    if (window.customElements?.whenDefined) {
      customElements.whenDefined('shop-login-button').then(bindAllShopLoginButtons);
    }
  })();
</script>
{%- endif -%}

{% stylesheet %}
  .account-drawer__email {
    font-size: var(--font-size--sm, 1.3rem);
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-55));
    word-break: break-word;
  }

  .account-drawer__content {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .account-drawer__signin-stack {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .account-drawer__signin-stack shop-login-button {
    display: block;
    width: 100%;
  }

  .account-drawer__signin-stack shop-login-button button {
    width: 100%;
  }

  .account-drawer__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .account-drawer__btn {
    width: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--gap-xs);
    padding-block: calc(var(--button-padding-vertical-mobile, var(--button-padding-vertical)) - .1rem);
  }

  .account-drawer__btn--shop {
    background-color: #5a31f4;
    color: #fff;
    border: none;
  }

  .account-drawer__btn-icon {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    flex-shrink: 0;
  }

  .account-drawer__btn-icon svg {
    width: 100%;
    height: 100%;
  }

  .account-drawer__logout {
    margin-top: 0.8rem;
    align-self: flex-start;
  }

  @media (min-width: 750px) {
    .account-drawer__btn {
      padding-block: calc(var(--button-padding-vertical) - .1rem);
    }
  }
{% endstylesheet %}
