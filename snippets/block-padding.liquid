{%- comment -%}
  Intended for blocks and sections that provide values for all the referenced settings.

  <div style="{%  render 'spacing-padding', settings: section.settings %}">

   Accepts:
      settings: {block.settings || section.settings}
{%- endcomment -%}
{%- capture padding_style -%}
    {% if settings.padding_top != nil %}--pt:{{ settings.padding_top | default: 0 }}px;{% endif %}
    {% if settings.padding_bottom != nil %}--pb:{{ settings.padding_bottom | default: 0 }}px;{% endif %}
    {% if settings.padding_left != nil %}--pl:{{ settings.padding_left | default: 0 }}px;{% endif %}
    {% if settings.padding_right != nil %}--pr:{{ settings.padding_right | default: 0 }}px;{% endif %}
    {% if settings.padding_top_mb != nil %}--pt_mb:{{ settings.padding_top_mb | default: 0 }}px;{% endif %}
    {% if settings.padding_bottom_mb != nil %}--pb_mb:{{ settings.padding_bottom_mb | default: 0 }}px;{% endif %}
    {% if settings.padding_left_mb != nil %}--pl_mb:{{ settings.padding_left_mb | default: 0 }}px;{% endif %}
    {% if settings.padding_right_mb != nil %}--pr_mb:{{ settings.padding_right_mb | default: 0 }}px;{% endif %}
{%- endcapture -%}
{{- padding_style | strip | strip_newlines -}}
