        {
          "value": "capitalize",
          "label": "t:options.capitalize"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "wrap",
      "label": "t:settings.wrap",
      "default": "nowrap",
      "options": [
        {
          "value": "pretty",
          "label": "t:options.pretty"
        },
        {
          "value": "balance",
          "label": "t:options.balance"
        },
        {
          "value": "nowrap",
          "label": "t:options.none"
        }
      ]
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#E24C21"
    },
    {
      "type": "color",
      "id": "accent_color_hover",
      "label": "Accent Color Hover",
      "default": "#C13B13"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Label",
      "default": "GET THE BUNDLE"
    }
  ],
  "presets": [
    {
      "name": "Product bundle"
    }
  ]
}
{% endschema %}
