{%- liquid
  assign block_id = block.id
  assign block_stts = block.settings
  assign type_preset = 'custom'
  assign tab_font_weight = block_stts.font_weight
  if tab_font_weight == 'default'
    assign tab_font_weight = blank
  endif

  capture tab_trigger_classes
    echo type_preset
    echo ' custom-typography'
    if block_stts.font_size != blank
      echo ' custom-font-size'
    endif
  endcapture
  
  assign has_collections = false
  if block_stts.collection_list != blank
    assign collection_count = 0
    for col in block_stts.collection_list
      assign collection_count = collection_count | plus: 1
    endfor
    if collection_count > 0
      assign has_collections = true
    endif
  endif
-%}

<div class="featured-tab-bundle__content-col featured-tab-bundle-block--{{ block_id }}"
  style="
    --featured-tab-bundle-accent: {{ block_stts.accent_color }};
    --featured-tab-bundle-accent-hover: {{ block_stts.accent_color_hover }};
  "
>
  <featured-tab-bundle class="w-full">
    <tabs-component>
      {%- if has_collections -%}
        <div class="featured-tab-bundle__tabs-header-wrapper">
          <div class="featured-tab-bundle__tabs-header">
            {%- for collection in block_stts.collection_list -%}
              <a
                href="#tab-pane-{{ block_id }}-{{ forloop.index }}"
                class="featured-tab-bundle__tab-trigger tabs-component-panel-trigger {{ tab_trigger_classes }}{% if forloop.first %} --active{% endif %}"
                style="{% render 'typography-style', settings: block_stts, preset: type_preset, weight: tab_font_weight %}"
              >
                {{ collection.title | escape }}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      
      {%- if has_collections -%}
        {%- for collection in block_stts.collection_list -%}
          <div id="tab-pane-{{ block_id }}-{{ forloop.index }}" class="featured-tab-bundle__tab-content tabs-component-content{% if forloop.first %} --active{% endif %}">
            <div class="featured-tab-bundle__products-list">
              {%- if collection.products.size > 0 -%}
                {%- for product in collection.products limit: block_stts.products_to_show -%}
                  {%- assign variant = product.selected_or_first_available_variant -%}
                  <div class="featured-tab-bundle__product-item" data-variant-id="{{ variant.id }}" data-available="{{ variant.available }}">
                    {%- content_for 'block', type: 'card-product-flex', id: 'product-bundle-item', closest.product: product -%}
                  </div>
                {%- endfor -%}
              {%- else -%}
                <p class="center" style="--p: var(--padding-4xl);">{{ 'content.sorry_no_products' | t }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
      
      <div class="featured-tab-bundle__action">
        <button type="button" class="featured-tab-bundle__cta-button button">
          <span class="featured-tab-bundle__cta-text">{{ block_stts.cta_text | default: 'GET THE BUNDLE' }}</span>
          <span class="featured-tab-bundle__cta-spinner loading__spinner hidden">
            <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
              <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
            </svg>
          </span>
        </button>
      </div>
      
    </tabs-component>
  </featured-tab-bundle>
</div>

{% schema %}
{
  "name": "Product bundle",
  "tag": null,
  "settings": [
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections (Tabs)",
      "limit": 5
