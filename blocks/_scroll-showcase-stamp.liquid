      ],
      "default": "sparkle"
    },
    {
      "type": "range",
      "id": "separator_size",
      "label": "Separator size",
      "min": 6,
      "max": 18,
      "step": 1,
      "unit": "%",
      "default": 10,
      "visible_if": "{{ block.settings.separator_icon != 'none' }}"
    },
    {
      "type": "select",
      "id": "color",
      "label": "t:settings.color",
      "options": [
        {
