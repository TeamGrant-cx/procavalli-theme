    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 50,
      "step": 1,
      "label": "t:settings.speed",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:settings.pause_on_hover",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Scroll showcase stamp",
      "category": "t:categories.decorative"
    }
  ]
}
{% endschema %}
