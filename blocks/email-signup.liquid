
{% if block.settings.show_subscription or block.settings.auto_responsive %}
  {{ 'container-block.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- liquid
  assign container_class = ''
  if block.settings.show_subscription or block.settings.auto_responsive
    assign container_class = block.settings.container_max_width | default: 'container-max-500'
  endif
-%}

{% capture agree_condition %}
  {%- if block.settings.agree_condition and block.settings.agree_condition_text != blank -%}
    {% assign alignment = block.settings.input_alignment | prepend: 'justify-' %}
    <div class="spacing-style newsletter-form__checkbox"
      style="--padding-block-start: {{ block.settings.condition-padding-block-start }}px; --padding-block-end:{{- block.settings.condition-padding-block-end -}}px;--padding-inline-start: 0px;--padding-inline-end: 0px;"
    >
      {% assign checkbox_id = block.id | prepend: 'agree_condition-' %}
      {% render 'checkbox', label: block.settings.agree_condition_text, id: checkbox_id, name: checkbox_id, required: true, alignment: alignment %}
    </div>
  {%- endif -%}
{% endcapture %}

{% capture input_description %}
  {%- if block.settings.show_input_description and block.settings.input_description != blank -%}
    <div
      class="spacing-style newsletter-form__description left"
      style="--text-align: left;--padding-block-start: {{ block.settings.description-padding-block-start }}px; --padding-block-end:{{- block.settings.description-padding-block-end -}}px;"
    >
      {% render 'text', fallback_text: block.settings.input_description, block: block %}
    </div>
  {%- endif -%}
{% endcapture %}

{%- liquid
  if block.settings.input_type_preset == 'custom'
    assign input_type_preset_class = 'custom-typography'
    if block.settings.input_font_size != blank
      assign input_type_preset_class = input_type_preset_class | append: ' custom-font-size'
    endif
  else
    assign input_type_preset_class = block.settings.input_type_preset
  endif

  assign input_font_weight = block.settings.input_font_weight
  if input_font_weight == 'default'
    assign input_font_weight = blank
  endif
-%}

{%- capture input_typography_style -%}
  {%- if block.settings.input_type_preset == 'custom' -%}
    {%- render 'typography-style',
      settings: block.settings,
      preset: 'custom',
      font: block.settings.input_font,
      font_size: block.settings.input_font_size,
      weight: input_font_weight,
      line_height: block.settings.input_line_height,
      letter_spacing: block.settings.input_letter_spacing
    -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture submit_class -%}
email-signup__button--size-{{ block.settings.submit_width }}
{% if block.settings.button_type_preset == 'custom' %}
  custom-typography custom-font-size
{% else %}
  {{ block.settings.button_type_preset }}
{% endif %}
{% if block.settings.style_class != 'button-custom' %} {{ block.settings.style_class }}{% else %}{% if block.settings.hide_submit_border %} bor-none{% endif %} {% endif %} {{ block.settings.style_class }}--{{ block.id }}{% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }}{% endif %}
  {% if block.settings.custom_button_padding %} email-signup__button-custom-padding {% endif %}
{%- endcapture -%}

{%- capture submit_button_class -%}
size-style email-signup__button{% if block.settings.integrated_button %} email-signup__button--integrated {% if block.settings.custom_integrated_button_size %} custom-integrated-button-size {% endif %}{% endif %} email-signup__button--{{ block.settings.display_type }} {{ submit_class }}{% if block.settings.display_type == 'icon' and block.settings.background_button == false %} email-signup__button--icon-fill{% endif %}{% if block.settings.display_type == 'icon' %} submit-icon-size{% endif %}
{%- endcapture -%}

{%- capture submit_button_style -%}
  {% if block.settings.display_type == 'icon' %}
    --icon-size-desktop: {{ block.settings.icon_size_desktop }}px;
    --icon-size-mobile: {{ block.settings.icon_size_mobile }}px;
  {% endif %}

  {%- if block.settings.integrated_button -%}
    --size-style-width: fit-content;
    {% if block.settings.custom_integrated_button_size %}
      --size-style-width-desktop: {{ block.settings.integrated_button_width }}px;
    {% endif %}
  {%- else -%}
    {%- if block.settings.submit_width == 'custom' -%}
      --size-style-width: {{- block.settings.submit_custom_width }}%;
    {%- else -%}
      --size-style-width: {{ block.settings.submit_width }};
    {%- endif -%}

    {% if block.settings.submit_width_mobile == 'custom' %}
      --size-style-width-mobile: {{- block.settings.submit_custom_width_mobile }}%;
      --size-style-width-mobile-min: {{- block.settings.submit_custom_width_mobile }}%;
    {%- elsif block.settings.submit_width_mobile == 'fit-content' -%}
      --size-style-width-mobile: {{ block.settings.submit_width_mobile }};
      --size-style-width-mobile-min: {{ block.settings.submit_width_mobile }};
    {%- endif -%}
  {%- endif -%}

  {% if block.settings.button_type_preset == 'custom' %}
    {% render 'typography-style', settings: block.settings, preset: 'custom' %}
  {% endif %}
  {% if block.settings.custom_button_padding %}
    --submit-padding-vertical: {{ block.settings.vertical_padding }}px;
    --submit-padding-horizontal: {{ block.settings.horizontal_padding }}px;
  {% endif %}
{%- endcapture -%}

{%- capture submit_button_content -%}
  {% if block.settings.display_type == 'text' %}
    <span class="button-overflow relative overflow-hidden" data-button-text="{{ block.settings.label }}">
      <span class="button-text-main inline-block relative z-1">{{ block.settings.label }}</span>
    </span>
  {% else %}
    {%- if block.settings.icon_type == 'chevron' -%}
      {{- 'icon-caret.svg' | inline_asset_content -}}
    {%- elsif block.settings.icon_type == 'arrow' -%}
      {{- 'icon-arrow.svg' | inline_asset_content -}}
    {%- else -%}
      {{- 'icon-fly.svg' | inline_asset_content -}}
    {%- endif -%}
  {% endif %}
{%- endcapture -%}

<email-signup
  class="email-signup-block size-style spacing-style{% if block.settings.inherit_color_scheme == false %} color-scheme-custom{% endif %}{% if block.settings.custom_input_height %} custom-input-height{% endif %}{% if container_class != blank %} {{ container_class }}{% endif %}"
  style="
    {% render 'size-style', settings: block.settings %}{% render 'spacing-style', settings: block.settings %}--gap: {{ block.settings.gap }}px;
    {% if block.settings.inherit_color_scheme == false %}
      {% render 'color-scheme-style', settings: block.settings %}
    {% endif %}
    --input-height: {{ block.settings.input_height }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.show_subscription -%}
    <div class="subscription-form email-signup__input-groups
      {% if block.settings.auto_responsive %} email-signup__auto-responsive {% endif %}
      {% if block.settings.button_on_new_line and block.settings.integrated_button == false %} email-signup__input-groups--stacked{% endif %}
      {% if block.settings.show_subscription %} flex flex-row{% endif %}
      no-js-hidden" style="--lg-gap: 50px;
    ">
      {% if block.settings.subscription_text != blank %}
        {%- liquid
          assign subscription_type_preset = block.settings.subscription_type_preset | default: 'rte'
          assign subscription_font_weight = block.settings.subscription_font_weight
          if subscription_font_weight == 'default'
            assign subscription_font_weight = blank
          endif

          assign subscription_text_classes = 'subscription-text email-signup__input ' | append: block.settings.input_alignment
          if subscription_type_preset == 'custom'
            assign subscription_text_classes = subscription_text_classes | append: ' custom-typography'
            if block.settings.subscription_font_size != blank
              assign subscription_text_classes = subscription_text_classes | append: ' custom-font-size'
            endif
          elsif subscription_type_preset != blank
            assign subscription_text_classes = subscription_text_classes | append: ' ' | append: subscription_type_preset
          endif
          if subscription_type_preset == 'rte' or subscription_type_preset == 'paragraph'
            assign subscription_text_classes = subscription_text_classes | append: ' rte'
          endif
          if subscription_type_preset != 'rte' and block.settings.subscription_color != blank
            assign subscription_text_classes = subscription_text_classes | append: ' custom-color'
          endif
        -%}
        <div
          class="{{ subscription_text_classes }}"
          style="
            {% render 'typography-style',
              settings: block.settings,
              preset: subscription_type_preset,
              font: block.settings.subscription_font,
              font_size: block.settings.subscription_font_size,
              weight: subscription_font_weight,
              line_height: block.settings.subscription_line_height,
              letter_spacing: block.settings.subscription_letter_spacing,
              case: block.settings.subscription_case,
              wrap: block.settings.subscription_wrap,
              color: block.settings.subscription_color
            %}
          "
        >
          {{ block.settings.subscription_text }}
        </div>
      {% endif %}
      <button
        type="submit"
        class="{% if block.settings.open_newsletter_popup %} open-newsletter-popup-button{% else %} promo-btn{% endif %} {{ submit_button_class }}"
        {% if block.settings.display_type != 'text' %}
          aria-label="{{ 'content.button_label' | t }}"
        {% endif %}
        style="{{ submit_button_style }}"
      >
        {{ submit_button_content }}
      </button>
    </div>
  {%- endif -%}

  {%- if block.settings.open_newsletter_popup == false -%}
    {% assign form_id = block.id | prepend: 'EmailSignup-' %}

    {%- form 'customer', id: form_id, class: 'email-signup__form' %}
      <div
        class="email-signup__input-groups
          {% if block.settings.show_subscription %} flex flex-row{% endif %}
          {% if block.settings.auto_responsive %} email-signup__auto-responsive{% endif %}
          {% if block.settings.button_on_new_line and block.settings.integrated_button == false %} email-signup__input-groups--stacked{% endif %}
          {% if block.settings.border != 'none' %}border-style{% endif %}
          spacing-style
        "
        style="
          {% if block.settings.border != 'none' %}
            --padding-block-start: {{ block.settings.field-padding-block-start | default: 0 }}px;
            --padding-block-end:{{- block.settings.field-padding-block-end | default: 0 -}}px;
            --padding-inline-start:{{ block.settings.field-padding-inline-start | default: 0 }}px;
            --padding-inline-end:{{- block.settings.field-padding-inline-end | default: 0 -}}px;
          {% endif %}
          --input-border-width: {{ block.settings.input_border_width }}px;
          --input-border-radius: {{ block.settings.input_border_radius }}px;
          {% if block.settings.integrated_button %}
            --padding-vertical: 1.6rem;
            --padding-horizontal: 1.2rem;
          {% endif %}
          {% render 'border-override', settings: block.settings %}

          {%- if block.settings.submit_width == 'custom' -%}
            --size-style-width: {{- block.settings.submit_custom_width }}%;
          {%- else -%}
            --size-style-width: {{ block.settings.submit_width }};
          {%- endif -%}
        "
      >
        <div class="email-signup__input-group" style="--focus-border-color: {{ block.settings.focus_border_color }};">
          <label
            for="EmailInput-{{ block.id }}"
            class="visually-hidden"
          >
            {% if block.settings.input_label != blank -%}
              {{- block.settings.input_label -}}
            {%- else -%}
              {{- 'content.label' | t -}}
            {%- endif %}
          </label>
          <input
            id="EmailInput-{{ block.id }}"
            class="email-signup__input email-signup__input--{{ block.settings.border_style }} {{ block.settings.input_alignment }} {{ input_type_preset_class }}{% if block.settings.input_focus_effect != 'none' %} has-focus-border input-{{ block.settings.input_focus_effect }}{% endif %}"
            type="email"
            name="contact[email]"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{% if block.settings.input_label != blank %}{{ block.settings.input_label }}{% else %}{{ 'content.label' | t }}{% endif %}"
            required
            style="{{ input_typography_style }}"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="Email-signup__message-error-{{ block.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="Email-signup__message-success-{{ block.id }}"
            {% endif %}
          >
          {% if block.settings.input_focus_effect != 'none' %}
            <span class="focus-border">
              <i></i>
            </span>
          {% endif %}
        </div>

        <button
          id="EmailSignup-submit-{{ block.id }}"
          type="submit"
          class="{{ submit_button_class }}"
          {% if block.settings.display_type != 'text' %}
            aria-label="{{ 'content.button_label' | t }}"
          {% endif %}
          style="{{ submit_button_style }}"
        >
          {{ submit_button_content }}
        </button>
      </div>
      {%- if block.settings.display_type == 'text' and block.settings.integrated_button == false -%}
        {{ agree_condition }}
        {{ input_description }}
      {%- endif -%}

      {%- if block.settings.display_type != 'text' or block.settings.integrated_button -%}
        {{ agree_condition }}
        {{ input_description }}
      {%- endif -%}

      {%- if form.errors -%}
        <div
          id="Email-signup__message-error-{{ block.id }}"
          class="email-signup__message email-signup__message--error"
          tabindex="-1"
        >
          <div class="alertBox alertBox--error">
            <svg
              class="svg-wrapper icon-error"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
              focusable="false"
              aria-hidden="true"
            >
              {%- render 'icon', icon: 'error'  -%}
            </svg>
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </div>
        </div>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <div
          id="Email-signup__message-success-{{ block.id }}"
          class="email-signup__message email-signup__message--success"
          tabindex="-1"
          style="--mt: 1rem"
        >
          <div class="alertBox alertBox--success">
            <span class="svg-wrapper icon-success">
              {{ 'icon-checkmark.svg' | inline_asset_content }}
            </span>
            <p class="email-signup__message-text m-0">{{ 'content.success' | t }}</p>
          </div>
        </div>
      {%- endif -%}
    {% endform %}
  {%- endif -%}
</email-signup>

{% schema %}
{
  "name": "t:names.email_signup",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.email_signup_create_customer_profiles"
    },
    {
      "type": "header",
      "content": "Subscription form"
    },
    {
      "type": "checkbox",
      "id": "show_subscription",
      "label": "t:settings.show_subscription_form_on_promotion_click",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "open_newsletter_popup",
      "label": "Open newsletter popup",
      "default": false,
      "visible_if": "{{ block.settings.show_subscription }}"
    },
    {
      "type": "inline_richtext",
      "id": "subscription_text",
      "label": "t:settings.text",
      "default": "Sign up to be the first to know when the event is live!",
      "visible_if": "{{ block.settings.show_subscription }}"
    },
    {
      "type": "select",
      "id": "subscription_type_preset",
      "label": "t:settings.preset",
      "options": [
        {
          "value": "rte",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "rte",
      "info": "t:info.edit_presets_in_theme_settings",
      "visible_if": "{{ block.settings.show_subscription }}"
    },
    {
      "type": "select",
      "id": "subscription_font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "var(--font-body--family)",
          "label": "t:options.body"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "t:options.subheading"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "t:options.heading"
        }
      ],
      "default": "var(--font-body--family)",
      "visible_if": "{{ block.settings.show_subscription and block.settings.subscription_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "subscription_font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "1.0rem",
          "label": "10px"
        },
        {
          "value": "1.2rem",
          "label": "12px"
        },
        {
          "value": "1.4rem",
          "label": "14px"
        },
        {
          "value": "1.6rem",
          "label": "16px"
        },
        {
          "value": "1.8rem",
          "label": "18px"
        },
        {
          "value": "2.0rem",
          "label": "20px"
        },
        {
          "value": "2.2rem",
          "label": "22px"
        },
        {
          "value": "2.4rem",
          "label": "24px"
        },
        {
          "value": "2.6rem",
          "label": "26px"
        },
        {
          "value": "2.8rem",
          "label": "28px"
        },
        {
          "value": "3.0rem",
          "label": "30px"
        },
        {
          "value": "3.2rem",
          "label": "32px"
        },
        {
          "value": "3.4rem",
          "label": "34px"
        },
        {
          "value": "3.6rem",
          "label": "36px"
        },
        {
          "value": "4.0rem",
          "label": "40px"
        },
        {
          "value": "5.0rem",
          "label": "50px"
        },
        {
          "value": "6.0rem",
          "label": "60px"
        },
        {
          "value": "7.0rem",
          "label": "70px"
        },
        {
          "value": "8.0rem",
          "label": "80px"
        },
        {
          "value": "9.0rem",
          "label": "90px"
        },
        {
          "value": "10.0rem",
          "label": "100px"
        },
        {
          "value": "12.0rem",
          "label": "120px"
        }
      ],
      "default": "1.6rem",
      "visible_if": "{{ block.settings.show_subscription and block.settings.subscription_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "subscription_font_weight",
      "label": "t:settings.weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "400",
          "label": "t:options.regular"
        },
        {
          "value": "600",
          "label": "t:options.semibold"
        },
        {
          "value": "700",
          "label": "t:options.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.show_subscription and block.settings.subscription_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "subscription_line_height",
      "label": "t:settings.line_height",
      "options": [
        {
          "value": "tight",
          "label": "t:options.tight"
        },
        {
          "value": "normal",
          "label": "t:options.normal"
        },
        {
          "value": "loose",
          "label": "t:options.loose"
        }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.show_subscription and block.settings.subscription_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "subscription_letter_spacing",
      "label": "t:settings.letter_spacing",
      "options": [
        {
          "value": "tight",
          "label": "t:options.tight"
        },
        {
          "value": "normal",
          "label": "t:options.normal"
        },
        {
          "value": "loose",
          "label": "t:options.loose"
        }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.show_subscription and block.settings.subscription_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "subscription_case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        },
        {
          "value": "capitalize",
          "label": "t:options.capitalize"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.show_subscription and block.settings.subscription_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "subscription_wrap",
      "label": "t:settings.wrap",
      "default": "pretty",
      "options": [
        {
          "value": "pretty",
          "label": "t:options.pretty"
        },
        {
          "value": "balance",
          "label": "t:options.balance"
        },
        {
          "value": "nowrap",
          "label": "t:options.none"
        }
      ],
      "visible_if": "{{ block.settings.show_subscription and block.settings.subscription_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "subscription_color",
      "label": "t:settings.color",
      "options": [
        {
          "value": "var(--color-foreground)",
          "label": "t:options.text"
        },
        {
          "value": "var(--color-foreground-heading)",
          "label": "t:options.heading"
        },
        {
          "value": "var(--color-primary)",
          "label": "t:options.link"
        }
      ],
      "default": "var(--color-foreground)",
      "visible_if": "{{ block.settings.show_subscription and block.settings.subscription_type_preset != 'rte' }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "t:settings.width_tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
