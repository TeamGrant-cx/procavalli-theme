{% liquid
  assign image = block.settings.image
  assign link = block.settings.link
  assign is_first = false

  if section.blocks.first.id == block.id
    assign is_first = true
  endif

  assign padding_top = '125%'
  if image != blank
    assign padding_top = 1 | divided_by: image.aspect_ratio | times: 100 | append: '%'
    unless image.presentation.focal_point == '50.0% 50.0%'
      assign padding_top = 1 | divided_by: image.aspect_ratio | times: 120 | append: '%'
    endunless
  endif

  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '300, 450, 600, 750, 900, 1050, 1200, 1350, 1500, 1650, 1800, 1950, 2000, 2500, 3000, 3500, 4000, 5000'
%}

<div
  class="image-item{% if is_first %} item-active{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="image-container">
    <div class="img-box">
      <a
        {% if link == blank %}
          role="link"
          aria-disabled="true"
        {% else %}
          href="{{ link }}"
        {% endif %}
        class="image"
        style="--image-padding-top: {{ padding_top }};"
        title="{{ image.alt | default: shop.name | escape }}"
      >
        {%- if image != blank -%}
          {%- capture image_style -%}
            {%- unless image.presentation.focal_point == '50.0% 50.0%' -%}
              object-position: {{ image.presentation.focal_point }};
            {%- endunless -%}
          {%- endcapture -%}
          {%- render 'image',
            image: image,
            class: 'multilayer-image-item__image',
            height: image.height,
            sizes: sizes,
            widths: widths,
            style: image_style
          -%}
        {%- else -%}
          <div class="placeholder multilayer-image-item__placeholder">
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </a>
    </div>
  </div>

  <div
    class="
      content-inner
      spacing-style
      layout-panel-flex
      layout-panel-flex--{{ block.settings.content_direction | default: 'column' }}
    "
    style="
      {% render 'spacing-style', settings: block.settings %}
      {% render 'layout-panel-style', settings: block.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Image panel",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "flex-end",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-end",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Image panel",
      "blocks": {
        "heading": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h3>Image title</h3>"
          }
        },
        "description": {
          "type": "text",
          "name": "t:names.description",
          "settings": {
            "text": "<p>Short description</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "label": "Learn More"
          }
        }
      },
      "block_order": ["heading", "description", "button"]
    }
  ]
}
{% endschema %}
