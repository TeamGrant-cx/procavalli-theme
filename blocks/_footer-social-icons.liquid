<div class="footer-utilities__group footer-utilities__group--right" {{ block.shopify_attributes }}>
  <div
    class="social-icons__wrapper"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.social_media_links",
  "tag": null,
  "blocks": [
    {
      "type": "_social-link"
    }
  ],
  "presets": [
    {
      "name": "t:names.social_media_links",
      "blocks": {
        "_social-link_facebook": {
          "type": "_social-link"
        },
        "_social-link_instagram": {
          "type": "_social-link"
        },
        "_social-link_x": {
          "type": "_social-link"
        },
        "_social-link_youtube": {
          "type": "_social-link"
        },
        "_social-link_tiktok": {
          "type": "_social-link"
        },
        "_social-link_pinterest": {
          "type": "_social-link"
        },
        "_social-link_tumblr": {
          "type": "_social-link"
        },
        "_social-link_snapchat": {
          "type": "_social-link"
        }
      },
      "block_order": [
        "_social-link_facebook",
        "_social-link_instagram",
        "_social-link_x",
        "_social-link_youtube",
        "_social-link_tiktok",
        "_social-link_pinterest",
        "_social-link_tumblr",
        "_social-link_snapchat"
      ]
    }
  ]
}
{% endschema %}
