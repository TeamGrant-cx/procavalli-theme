          "blocks": {
            "kicker": {
              "type": "text",
              "settings": {
                "text": "<p>Our Founder</p>",
                "width": "100%",
                "custom_width": 100,
                "inherit_text_alignment": false,
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-heading--family)",
